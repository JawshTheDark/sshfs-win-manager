{
  "name": "sshfs-win-manager",
  "version": "2.0.0",
  "author": "Evandro Araujo <evandroprogram@gmail.com>",
  "description": "A GUI for SSHFS-Win (https://github.com/billziss-gh/sshfs-win)",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:tray": "electron-vite dev -- --systray",
    "start": "electron-vite preview",
    "build": "electron-vite build && electron-builder",
    "build:dir": "electron-vite build && electron-builder --dir",
    "pack": "electron-vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/**/*.test.js\""
  },
  "build": {
    "productName": "SSHFS-Win Manager",
    "appId": "dev.babum.apps.sshfs-win-manager",
    "artifactName": "sshfs-win-manager-setup-v${version}.${ext}",
    "nsis": {
      "oneClick": true,
      "installerIcon": "build/icons/setup-icon.ico",
      "uninstallDisplayName": "SSHFS-Win Manager"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "icon": "build/icons/app-icon.ico",
      "target": "nsis"
    },
    "publish": null
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "floating-vue": "^5.4.0",
    "less": "^4.9.1",
    "neostandard": "^0.14.1",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.4.0"
  }
}
